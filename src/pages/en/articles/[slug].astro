---
import { articlesIn } from '../../../lib/articles.ts';
import ArticlePage from '../../../components/ArticlePage.astro';

export async function getStaticPaths() {
  return (await articlesIn('en')).map(({ article, tr }) => ({ params: { slug: tr.slug }, props: { article, tr } }));
}
const { article, tr } = Astro.props;
---
<ArticlePage locale="en" article={article} tr={tr} />
