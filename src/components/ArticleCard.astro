---
import { t } from '../i18n/index.ts';
import { articleBase, type Locale } from '../i18n/routes.ts';
import type { PublicMediaT } from '../shared/public.ts';
import Placeholder from './Placeholder.astro';
import { findFor } from '../shared/finds.ts';

interface Props {
  locale: Locale; featured?: boolean;
  series: string; slug: string; title: string; excerpt: string; date: string; minutes: number;
  isPlaceholder: boolean; media?: PublicMediaT; alt?: string;
}
const { locale, featured = false, series, slug, title, excerpt, date, minutes, isPlaceholder, media, alt } = Astro.props;
const m = t(locale);
const when = new Intl.DateTimeFormat(locale === 'id' ? 'id-ID' : 'en-GB', { dateStyle: 'long', timeZone: 'Asia/Jakarta' }).format(new Date(date));
// A Placeholder image is a plain surface slot at the real ratio, never a picture of nothing (UX-DR35).
const real = media && !media.isPlaceholder && alt ? media : undefined;
const widths = real ? [...real.variants].sort((a, b) => a - b) : [];
const src = (w: number) => `/media/${real!.id}-w${w}.webp`;
const Heading = featured ? 'h2' : 'h3';
---
<article class:list={['card', `s-${series}`, { featured }]}>
  <div class="media">
    {real
      ? <img src={src(widths[widths.length - 1])} srcset={widths.map((w) => `${src(w)} ${w}w`).join(', ')} sizes={featured ? '(min-width: 1100px) 66vw, 100vw' : '(min-width: 1100px) 33vw, 100vw'} width="3" height="2" alt={alt} loading="lazy" decoding="async" />
      : (isPlaceholder || media?.isPlaceholder)
        ? <div class="slot" data-find={findFor(slug)} role="img" aria-label={alt ?? m.site.placeholderMarker}></div>
        : <div class="slot" data-find={findFor(slug)} aria-hidden="true"></div>}
    {(isPlaceholder || media?.isPlaceholder) && <span class="mark"><Placeholder locale={locale} /></span>}
  </div>
  <Heading><a href={`${articleBase[locale]}${slug}/`}>{title}</a></Heading>
  <p class="excerpt">{excerpt}</p>
  <p class="meta"><span class="dot"></span><span>{m.series[series as keyof typeof m.series].label}</span><time datetime={date}>{when}</time></p>
</article>
<style>
  .card { position: relative; }
  .media { position: relative; aspect-ratio: 1 / 1; overflow: hidden; background: var(--c); margin-bottom: var(--space-4); }
  .media img, .slot { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 500ms var(--ease-out); }
  @media (hover: hover) { .card:hover .slot { transform: rotate(-5deg) scale(1.04); } .card:hover .media img { transform: scale(1.03); } }
  .mark { position: absolute; top: var(--space-3); left: var(--space-3); z-index: 1; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-4); margin: 0; font-size: var(--type-meta-size); font-weight: var(--type-meta-weight); line-height: var(--type-meta-leading); font-variant-numeric: tabular-nums; color: var(--color-ink-muted); }
  h2, h3 { font-weight: 800; margin: 0 0 var(--space-2); }
  h3 { font-size: var(--type-h3-size); line-height: var(--type-h3-leading); }
  h2 { font-size: var(--type-h1-size); line-height: var(--type-h1-leading); max-width: 18ch; }
  /* The title is the only link; its hit area covers the card and focus outlines the card (UX-DR14). */
  h2 a, h3 a { color: inherit; text-decoration: none; }
  h2 a::after, h3 a::after { content: ''; position: absolute; inset: 0; z-index: 2; }
  h2 a:focus-visible, h3 a:focus-visible { outline: none; }
  .card:has(a:focus-visible) { outline: var(--focus-ring-width) solid var(--color-accent); outline-offset: var(--focus-ring-offset); }
  .card:hover h2 a, .card:hover h3 a { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .excerpt { margin: 0 0 var(--space-3); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; max-width: 60ch; }
  @media (prefers-reduced-motion: reduce) { .media img, .slot { transition: none; } }
</style>
