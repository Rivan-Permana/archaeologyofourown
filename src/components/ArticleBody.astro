---
// One of the two files allowed to inject HTML: it only ever receives renderArticleHtml() output (AD-6).
const { html } = Astro.props as { html: string };
---
<div class="body" set:html={html} />
<style is:global>
  .body > * { margin: 0 0 var(--space-6); }
  /* Inside the reading column headings stay modest (critique 2026-11-19); the h2/h3 tokens are display sizes. */
  .body h2 { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.75rem, 3vw, 2.25rem); line-height: 1.05; margin-top: var(--space-12); }
  .body h3 { font-family: var(--font-display); font-weight: 800; font-size: 1.375rem; line-height: 1.15; margin-top: var(--space-8); }
  /* Pull quote: the display cut at a reading size, no italic, no rule; size and face set it apart (UX-DR22). */
  .body blockquote { margin: var(--space-12) 0; padding: 0; font-family: var(--font-display); font-stretch: 75%; font-weight: 800; font-style: normal; font-size: clamp(1.5rem, 2.6vw, 2rem); line-height: 1.15; }
  .body blockquote p { margin: 0; }
  .body figure { margin: var(--space-8) 0; }
  .body img { display: block; width: 100%; height: auto; background: var(--color-surface); }
  .body figcaption { margin-top: var(--space-2); font-size: var(--type-small-size); line-height: var(--type-small-leading); color: var(--color-ink-muted); }
  .body figcaption .credit::before { content: '· '; }
</style>
