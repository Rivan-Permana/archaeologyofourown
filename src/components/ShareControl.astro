---
import { t } from '../i18n/index.ts';
import type { Locale } from '../i18n/routes.ts';

// Both buttons need JavaScript, so they stay hidden without it (UX-DR25). Native share appears only where supported.
const { locale, title } = Astro.props as { locale: Locale; title: string };
const m = t(locale).article;
---
<div class="share" data-share data-title={title}>
  <button type="button" class="btn btn-secondary" data-copy data-done={m.copied} hidden>{m.copy}</button>
  <button type="button" class="btn btn-secondary" data-native hidden>{m.share}</button>
  <p role="status" class="status" data-status></p>
</div>
<script>
  const root = document.querySelector<HTMLElement>('[data-share]');
  if (root) {
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const copy = root.querySelector<HTMLButtonElement>('[data-copy]')!;
    const native = root.querySelector<HTMLButtonElement>('[data-native]')!;
    copy.hidden = false;
    if ('share' in navigator) native.hidden = false;
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(location.href.split('#')[0]);
        status.textContent = copy.dataset.done ?? '';
      } catch { status.textContent = ''; }
    });
    native.addEventListener('click', () => navigator.share({ title: root.dataset.title, url: location.href.split('#')[0] }).catch(() => {}));
  }
</script>
<style>
  .share { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .status { margin: 0; font-size: var(--type-small-size); color: var(--color-ink-muted); min-height: 1.5em; }
</style>
