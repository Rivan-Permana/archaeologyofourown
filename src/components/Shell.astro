---
import { t } from '../i18n/index.ts';
import { routeFor, type Locale } from '../i18n/routes.ts';
import Page from '../layouts/Page.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const m = t(locale);
const hrefs = { id: routeFor('home', 'id'), en: routeFor('home', 'en') };
---
<Page locale={locale} title={m.site.name} description={m.site.placeholder} hrefs={hrefs}>
  <div class="page">
    <h1>{m.site.name}</h1>
    <p>{m.site.placeholder}</p>
  </div>
</Page>
<style>
  .page { max-width: var(--measure); margin: 0 auto; padding: var(--space-12) var(--margin-mobile); }
  h1 { font-family: var(--font-display); font-size: var(--type-h1-size); font-weight: var(--type-h1-weight); line-height: var(--type-h1-leading); margin: 0 0 var(--space-6); }
  p { margin: 0 0 var(--space-4); }
</style>
