{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "archaeologyofourown",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/admin/*", "/api/*", "/media/*"]
  },
  "preview_urls": false,
  // No ids on purpose: created on first approved deploy, local dev uses miniflare. Neutral names (AR3).
  "d1_databases": [{ "binding": "DB", "database_name": "archaeologyofourown", "migrations_dir": "src/server/db/migrations" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "archaeologyofourown-media" }],
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
