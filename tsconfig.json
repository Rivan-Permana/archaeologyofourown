{
  "extends": "astro/tsconfigs/strict",
  "include": ["worker-configuration.d.ts", ".astro/types.d.ts", "src/**/*", "scripts/**/*", "tests/**/*"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowImportingTsExtensions": true,
    "types": ["node"]
  }
}
